{"type":"运行JS代码","delayUnit":1,"jsCode":"\nvar c0Stamp = String(Date.now()) + '-' + String(Math.random()).slice(2);\nvar c0Req = {schema:1,scope:'C0_SANDBOX',session_id:'C0S-'+c0Stamp,\n dispatch_id:'C0D-'+c0Stamp,route_id:'NO_GAME',segment_id:'NO_TOUCH',\n profile_id:'C0_SYNTHETIC',expected_producer:'C0_CHILD',end_anchor:'SYNTHETIC_END'};\nzdjl.setVar('dfC0Request', JSON.stringify(c0Req));\nzdjl.setVar('dfC0Active', JSON.stringify(c0Req), 'global');\nzdjl.setVar('dfC0Claim', '', 'global');\nzdjl.setVar('dfC0Result', '', 'global');\nzdjl.setVar('dfC0FailureObserved', '', 'global');\n"}
